<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B1020">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="18dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Life OS"
                android:textColor="#FFFFFF"
                android:textSize="28sp"
                android:textStyle="bold"/>
            <TextView
                android:id="@+id/guest"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GUEST"
                android:textColor="#C4B5FD"
                android:textSize="12sp"/>
        </LinearLayout>

        <TextView
            android:id="@+id/dateText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#94A3B8"
            android:textSize="14sp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tasksStat"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginEnd="7dp"
                android:background="#182238"
                android:gravity="center"
                android:text="TASKS
0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"/>
            <TextView
                android:id="@+id/balanceStat"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_weight="1"
                android:layout_marginStart="7dp"
                android:background="#182238"
                android:gravity="center"
                android:text="SALDO
Rp0"
                android:textColor="#FFFFFF"
                android:textSize="18sp"/>
        </LinearLayout>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Catat Pengeluaran"
            android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>

        <EditText
            android:id="@+id/expenseNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: beli mentega"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"/>

        <EditText
            android:id="@+id/expenseAmount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:hint="Jumlah (Rp)"
            android:inputType="number"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">
            <Button
                android:id="@+id/addExpenseButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="- Pengeluaran"/>
            <Button
                android:id="@+id/addIncomeButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="+ Pemasukan"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/expenseContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="vertical"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Tambah Task"
            android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>

        <EditText
            android:id="@+id/taskInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: belajar 30 menit"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"/>

        <Button
            android:id="@+id/addTaskButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Tambah Task"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Tasks"
            android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>

        <LinearLayout
            android:id="@+id/taskContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="22dp" android:text="Alarm"
            android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold"/>

        <EditText
            android:id="@+id/alarmText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Contoh: olahraga"
            android:inputType="text"
            android:textColor="#FFFFFF"
            android:textColorHint="#64748B"/>

        <Button
            android:id="@+id/alarmButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Set alarm 1 menit lagi"/>

        <Button
            android:id="@+id/notificationButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Aktifkan notifikasi"/>

        <TextView
            android:id="@+id/privacy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Guest mode • Data disimpan lokal • Tidak meminta password Google"
            android:textColor="#64748B"
            android:textSize="12sp"/>
    </LinearLayout>
</ScrollView>
